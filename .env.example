# Unified Lead Platform - Environment Variables Template
# Copy to .env.local and fill in your values. NEVER commit .env.local.

# ========================================
# Database
# ========================================
# Production: Supabase PostgreSQL connection string (Settings -> Database -> URI)
# Local dev: postgresql://<your-user>@localhost:5432/unified_lead_platform?schema=public
DATABASE_URL="postgresql://user@localhost:5432/unified_lead_platform?schema=public"

# ========================================
# Redis (for BullMQ job queue)
# ========================================
# Local dev: redis://localhost:6379
# Production: provided by Railway/Render/Upstash
REDIS_URL="redis://localhost:6379"

# ========================================
# API Keys (see docs/SETUP.md for how to get each one)
# ========================================
# Apollo.io: https://app.apollo.io/api-keys
APOLLO_API_KEY=""
# DeepSeek: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=""
# Firecrawl: https://firecrawl.dev/dashboard (Settings -> API Keys)
FIRECRAWL_API_KEY=""
# Million Verifier: https://app.millionverifier.com/settings
MILLION_VERIFIER_API_KEY=""

# ========================================
# App Config
# ========================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Simple password protection for MVP (single shared password, see DECISIONS.md SECURITY-002)
APP_PASSWORD=""
